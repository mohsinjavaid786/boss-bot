{
  "name": "boss-bot",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch apps/server/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "build": "vite build --config apps/web/vite.config.ts",
    "start": "node --import tsx apps/server/src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "tsx": "^4.19.0",
    "vite": "^6.4.0",
    "concurrently": "^9.1.0",
    "@playwright/test": "^1.51.0"
  }
}
